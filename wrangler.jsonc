// Configuración para Cloudflare Workers (sitio estático, sin código de servidor).
// El "name" debe coincidir con el nombre del Worker conectado al repositorio en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calculadora-estatal-presupuestos",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
